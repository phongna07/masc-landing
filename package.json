{
  "name": "masc-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "check-types": "pnpm -r --if-present run check-types",
    "dev:web": "pnpm --filter web run dev",
    "db:check": "pnpm --filter @masc-landing/db run db:check",
    "db:push": "pnpm --filter @masc-landing/db run db:push",
    "db:studio": "pnpm --filter @masc-landing/db run db:studio",
    "db:generate": "pnpm --filter @masc-landing/db run db:generate",
    "db:migrate": "pnpm --filter @masc-landing/db run db:migrate"
  },
  "dependencies": {
    "@masc-landing/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@masc-landing/config": "workspace:*",
    "@types/node": "^22.13.14",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
