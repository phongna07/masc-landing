# Database
# PostgreSQL connection string used by Drizzle and authentication.
DATABASE_URL=
# Alternative production connection (inactive).
# DATABASE_URL=

# Authentication
# Base URL of the application serving Better Auth.
BETTER_AUTH_URL=
# Secret used by Better Auth to sign and encrypt data (at least 32 characters).
BETTER_AUTH_SECRET=
# Application origin trusted by Better Auth for incoming requests.
CORS_ORIGIN=

# Google sign-in
# Google OAuth client ID for signing in with Google.
GOOGLE_CLIENT_ID=
# Google OAuth client secret paired with the client ID.
GOOGLE_CLIENT_SECRET=

# File storage (Cloudflare R2)
# Cloudflare account ID used to construct the R2 API endpoint.
R2_ACCOUNT_ID=
# R2 API access key ID for file uploads, downloads, and deletion.
R2_ACCESS_KEY_ID=
# R2 API secret paired with the access key ID.
R2_SECRET_ACCESS_KEY=
# R2 bucket holding uploaded application files.
R2_BUCKET=

# Email delivery (ZeptoMail)
# Sender email address used for MASC outgoing messages.
MAIL_USERNAME=
# Email address that receives replies to outgoing messages.
MAIL_REPLY_TO=masc26.work@gmail.com
# ZeptoMail API endpoint used to send email.
ZEPTOMAIL_URL=
# Authorization header value for the ZeptoMail API.
ZEPTOMAIL_TOKEN=

# PDF exporter
# Optional PDF exporter service URL; used by the admin service health check.
PDF_EXPORTER_URL=

# Ticket payments and background processing (server-only)
# Optional settings; configure PayOS and the worker before enabling ticket processing.
# PayOS client ID for ticket payments.
PAYOS_CLIENT_ID=
# PayOS API key for ticket payment requests.
PAYOS_API_KEY=
# PayOS checksum key for signing and verifying payment data.
PAYOS_CHECKSUM_KEY=
# Application origin for PayOS return and webhook URLs; no path, query, or credentials.
TICKET_APP_URL=
# Bearer secret protecting the ticket worker endpoint (at least 32 characters).
TICKET_WORKER_SECRET=

# Public registration display
# Browser-visible true/false flag for registration-related homepage content.
NEXT_PUBLIC_IS_REGISTRATION_OPENED=
